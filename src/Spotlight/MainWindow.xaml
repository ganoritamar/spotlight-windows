<Window x:Class="Spotlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight" Width="680" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        WindowStartupLocation="Manual" Background="Transparent"
        UseLayoutRounding="True" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- No title bar, but keep a real frame so Windows draws the acrylic backdrop, rounded corners and shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D92563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="#38101010">
        <StackPanel>
            <Grid Height="60" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           Foreground="#B3FFFFFF" VerticalAlignment="Center" Margin="0,2,14,0" />
                <TextBox x:Name="Query" Grid.Column="1" Background="Transparent" BorderThickness="0"
                         Foreground="White" CaretBrush="White" FontSize="22"
                         FontFamily="Segoe UI Variable Display, Segoe UI"
                         VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"
                         SelectionBrush="#4C8DFF" SelectionOpacity="0.45" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Spotlight Search" FontSize="22"
                           FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#73FFFFFF"
                           VerticalAlignment="Center" Margin="3,0,0,0" IsHitTestVisible="False" />
            </Grid>

            <Border x:Name="Divider" Height="1" Background="#1FFFFFFF" Visibility="Collapsed" />

            <ListBox x:Name="Results" Margin="8,6,8,8" Visibility="Collapsed" Padding="0"
                     Background="Transparent" BorderThickness="0" Foreground="White" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ResultItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="28" Height="28" Source="{Binding Icon}" Margin="2,0,12,0"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="11.5" Opacity="0.5"
                                       VerticalAlignment="Center" Margin="12,0,6,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
